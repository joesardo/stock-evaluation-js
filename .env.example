# Environment Variables Template

# Alpha Vantage API (https://www.alphavantage.co/)
# Free tier: 5 requests/min, 500/day
ALPHA_VANTAGE_API_KEY=demo

# Financial Modeling Prep API (https://financialmodelingprep.com/)
# Free tier: 250 requests/day
FINANCIAL_MODELING_PREP_API_KEY=

# IEX Cloud API (https://iexcloud.io/)
# Free tier: 100 messages/month
IEX_CLOUD_API_KEY=

# Yahoo Finance (no key needed for web scraping)
# Note: Web scraping may violate terms of service

# Database
DATABASE_PATH=./stock-data.db

# Logging
LOG_LEVEL=info
LOG_FILE=./stock-evaluation.log

# Cache
CACHE_TTL_MS=3600000

# General
NODE_ENV=development
