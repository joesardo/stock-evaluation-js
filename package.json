{
  "name": "stock-evaluation",
  "version": "1.0.0",
  "description": "Lightweight stock evaluation tool using public financial metrics",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "server": "ts-node api-server.ts",
    "evaluate": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "watchlist:list": "ts-node src/cli-watchlist.ts list",
    "watchlist:add": "ts-node src/cli-watchlist.ts add",
    "watchlist:remove": "ts-node src/cli-watchlist.ts remove"
  },
  "keywords": [
    "stock",
    "evaluation",
    "scoring",
    "investment",
    "finance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "yahoo-finance2": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.0"
  }
}
